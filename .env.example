# === Telegram ===
BOT_TOKEN=123456789:AAExample-Token-Bu-Yerga-Haqiqiy-Tokenni-Qoying
# Webhook uchun to'liq ochiq HTTPS manzil (nginx/Cloudflare Tunnel orqasida)
WEBHOOK_BASE_URL=https://falak-bot.example.com
WEBHOOK_PATH=/webhook
# Tasodifiy, uzun va maxfiy qator (masalan: openssl rand -hex 32)
WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_LONG_SECRET

# === Server ===
HOST=127.0.0.1
PORT=8080

# === Ma'lumotlar bazasi ===
DB_PATH=./data/falak.db

# === Open-Meteo ===
# Open-Meteo kalitsiz bepul, lekin agar kelajakda tijorat/kengaytirilgan
# tarifga o'tsangiz, shu yerga qo'shiladi.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# === Kesh ===
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE=2000

# === CORS (Mini App Cloudflare Pages manzili) ===
# Vergul bilan ajratilgan ro'yxat, masalan:
# https://falak-miniapp.pages.dev,https://falak.uz
CORS_ORIGINS=https://falak-miniapp.pages.dev

# === Log ===
LOG_LEVEL=INFO
